# ──────────────────────────────────────────────────────────────────────────────
# Visual Automata Studio — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
#
# SETUP INSTRUCTIONS
# ──────────────────
# 1. Create a Supabase project at https://supabase.com (free tier is sufficient)
# 2. In your project dashboard go to Settings → API
# 3. Copy the "Project URL" and "anon/public" key into a `.env` file in the
#    project root (copy this file: cp .env.example .env)
# 4. Run the SQL migration below in your Supabase SQL Editor
# 5. Restart the dev server: npm run dev
#
# SUPABASE DATABASE MIGRATION (run once in SQL Editor)
# ─────────────────────────────────────────────────────
#
#   -- Table to store per-user learning progress as JSON
#   create table if not exists user_progress (
#     user_id    uuid references auth.users on delete cascade primary key,
#     data       jsonb not null default '{}',
#     updated_at timestamptz not null default now()
#   );
#
#   -- Enable Row Level Security — users can only touch their own row
#   alter table user_progress enable row level security;
#
#   create policy "Users can read own progress"
#     on user_progress for select
#     using (auth.uid() = user_id);
#
#   create policy "Users can upsert own progress"
#     on user_progress for insert
#     with check (auth.uid() = user_id);
#
#   create policy "Users can update own progress"
#     on user_progress for update
#     using (auth.uid() = user_id);
#
#   create policy "Users can delete own progress"
#     on user_progress for delete
#     using (auth.uid() = user_id);
#
# ──────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL  (e.g. https://abcdefghij.supabase.co)
VITE_SUPABASE_URL=your_supabase_project_url_here

# Your Supabase anon/public API key  (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
